# Copie para .env e preencha. Nunca commite o .env.
# As variáveis entram aqui conforme cada módulo for criado.
# Sem valor = você define. Uma variável obrigatória vazia faz o serviço falhar na inicialização.

# --- Infra (Compose) ---
# Superusuário do Postgres: existe só dentro do contêiner do banco. Obrigatórias.
POSTGRES_USER=
POSTGRES_PASSWORD=
# Papel de aplicação (sem superusuário) criado pelo script de init. Obrigatórias.
TRENDGAP_DB_USERNAME=
TRENDGAP_DB_PASSWORD=
# Porta publicada no host para o frontend. Opcional (padrão 8080).
TRENDGAP_WEB_PORT=8080

# --- Backend (o Compose monta TRENDGAP_DB_URL e TRENDGAP_ML_BASE_URL; defina-as só para rodar fora do contêiner) ---
# URL JDBC começando por jdbc:postgresql://
# TRENDGAP_DB_URL=
# URL absoluta http/https do serviço de ML
# TRENDGAP_ML_BASE_URL=
# Tempo limite da sonda do ML, entre 100ms e 5s. Opcional (padrão 2s).
# TRENDGAP_ML_TIMEOUT=
# Portas HTTP e de gerenciamento do backend. Opcionais (padrão 8080 e 8081, diferentes entre si).
# TRENDGAP_HTTP_PORT=
# TRENDGAP_MANAGEMENT_PORT=

# --- Serviço de ML ---
# Opcionais: porta (padrão 8000) e nível de log (DEBUG, INFO, WARNING, ERROR; padrão INFO).
# TRENDGAP_ML_PORT=
# TRENDGAP_ML_LOG_LEVEL=

# --- Observabilidade (backend e ML) ---
# URL absoluta do coletor OTLP. Opcional; ausente = sem exportação.
# OTEL_EXPORTER_OTLP_ENDPOINT=
